# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# Consumer Premium plan (Garment Tool + Pose Tool + SVG customization).
# Always points at the CURRENT self-serve price ($29.99/mo as of 2026-09) —
# new Checkout sessions use this. Existing subscribers keep whatever price
# their own Stripe subscription already references, cached per-user on
# User.premiumPriceId/premiumUnitAmountCents rather than read from this
# var — see src/lib/premiumPricing.js. Create it with
# src/scripts/setup-premium-price-v2.js.
STRIPE_PREMIUM_PRICE_ID=

# API-access tiers (see src/lib/apiTiers.js) — created by
# src/scripts/setup-api-billing.js.
STRIPE_API_STARTER_PRICE_ID=
STRIPE_API_GROWTH_PRICE_ID=
STRIPE_API_OVERAGE_SEGMENTED_PRICE_ID=
STRIPE_API_OVERAGE_BGONLY_PRICE_ID=
STRIPE_BILLING_WEBHOOK_SECRET=

# Google Cloud Storage
STORAGE_BUCKET=fabric-now
GCS_BUCKET_NAME=fabric-now
STORAGE_FOLDER=FabricNow
# Optional when local development uses a service-account key. On App Engine,
# prefer Application Default Credentials / the runtime service account.
GOOGLE_CLOUD_PROJECT=stream-sell

# Optional app secrets
GEMINI_API_KEY=
# Text/vision model used by Fibo (chat) and the Pose Tool's pose analysis.
GEMINI_MODEL=gemini-3.6-flash
# Image-generation model used by the Pose Tool's front/side/back turnaround.
# gemini-2.5-flash-image is the current GA "Nano Banana" model. If your
# account has access to the newer gemini-3.1-flash-image (or gemini-3-pro-image
# for higher fidelity), you can override to that instead.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
MONGODB_URI=

# "Sign in with Google" — the client ID from your Google Cloud OAuth 2.0
# Client ID (Web application type). Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID
# in the frontend's env exactly (it's the audience the server verifies
# Google's ID tokens against).
GOOGLE_CLIENT_ID=

# Dashboard origin used for the GCS resumable-upload session CORS setup
DASHBOARD_ORIGIN=http://localhost:3000
