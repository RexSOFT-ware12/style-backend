# Paystack

FRONTEND_URL=http://localhost:3000
WORKSPACE_URL=http://localhost:4000/workspace

# Consumer Premium plan and API tiers. Create monthly plans in Paystack
# using the configured GHS amounts and set their plan codes below.
PAYSTACK_PREMIUM_PLAN_CODE=
PAYSTACK_API_STARTER_PLAN_CODE=
PAYSTACK_API_GROWTH_PLAN_CODE=

PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
# USD catalogue price shown to customers; Paystack plan amount below is GHS.
FABRICNOW_PREMIUM_PRICE_USD=29.99
PAYSTACK_PREMIUM_AMOUNT=350.13
PAYSTACK_API_STARTER_AMOUNT=934.00
PAYSTACK_API_GROWTH_AMOUNT=33730.80
PAYSTACK_API_OVERAGE_SEGMENTED_AMOUNT=572.08
PAYSTACK_API_OVERAGE_BGONLY_AMOUNT=233.50
PAYSTACK_USD_GHS_RATE=11.68
# Product catalogue prices are USD; order checkout converts server-side to GHS at this configured rate.
# Keep the monthly Paystack plan amounts in GHS and ensure their plan codes match exactly.

# --- Central payment gateway (FabricNow Pay) ---------------------------------
# Paystack allows ONE webhook URL per account, so it points at the gateway:
#   https://<pay-now-host>/webhooks/paystack
# The gateway forwards Style's events to POST /api/payments/paystack-events, signed with this secret.
# Must be identical to STYLE_EVENT_SECRET on the gateway (use 32+ random chars).
FABRIC_PAY_EVENT_SECRET=
# (Legacy) direct webhook https://<api-host>/api/paystack/webhook is only used until cutover is verified.

# Cloudinary stores product/workspace images and authenticated ZIP downloads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional app secrets
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_TAILOR_TOOLS_MODEL=gpt-4o-mini
OPENAI_FIBO_MODEL=gpt-4o-mini
# Pose Tool: vision model + image model for the front/side/back turnaround.
# gpt-image-2.5-sunburst may require OpenAI organization verification; or use dall-e-3.
OPENAI_POSE_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
MONGODB_DB_NAME=FabricNow
MONGODB_URI=

# "Sign in with Google" — the client ID from your Google Cloud OAuth 2.0
# Client ID (Web application type). Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID
# in the frontend's env exactly (it's the audience the server verifies
# Google's ID tokens against).
GOOGLE_CLIENT_ID=

# Company workspace
WORKSPACE_APP_NAME=FabricNow Workspace
# Internal URL of the Fabric Now pattern-processing worker.
# The browser NEVER calls this service directly.
FABRIC_NOW_SERVICE_URL=
FABRIC_NOW_INTERNAL_SECRET=replace-with-a-long-random-secret

# FabricNow Workspace AI uses OpenAI. Keep provider keys server-side only.
# Fibo, Pose Tool and pattern design also use OpenAI (OPENAI_API_KEY).
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
AI_VISION_PROVIDER=auto

# Company-scoped Pinterest integration
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:4000/api/companies/pinterest/oauth/callback
PINTEREST_FRONTEND_URL=http://localhost:5173
PINTEREST_TOKEN_ENCRYPTION_KEY=
PUBLIC_API_URL=http://localhost:4000
WORKSPACE_ORIGIN=http://localhost:5173

# Free photo search for the Inspiration Library + Gallery.
# Unsplash (recommended, instant key): https://unsplash.com/developers  -> New Application
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=fabricnow
# Pexels (new keys are currently paused by Pexels; only if you already have one)
PEXELS_API_KEY=
# Optional: force one when both are set (unsplash | pexels)
PHOTO_PROVIDER=

BG_MODEL=u2netp
# App Engine's deployment directory is read-only; use its writable temp filesystem.
BG_MODEL_DIR=/tmp/bg-models

# --- Email (Resend HTTPS API) -------------------------------------------
RESEND_API_KEY=
# General sender must belong to a domain verified in Resend.
RESEND_FROM_EMAIL=FabricNow <reply@support.fabricnow.pro>
# Optional separate sender for payment invoices; also must be verified in Resend.
RESEND_INVOICE_FROM_EMAIL=FabricNow Invoices <invoices@invoice.fabricnow.pro>
# Support inbox receives contact forms and sign-in alert copies.
SUPPORT_EMAIL=support@fabricnow.pro
CONTACT_EMAIL=support@fabricnow.pro
# Optional: public https PNG logo shown in emails (wordmark used if empty)
MAIL_LOGO_URL=
# Sign-in alerts: new (unrecognised device/location only) | always | off
SIGNIN_ALERT_MODE=always



# --- Admin dashboard -----------------------------------------------------
# Comma-separated emails that are always treated as admins (bootstrap the
# first admin with this, or run: node src/scripts/make-admin.js you@x.com).
ADMIN_EMAILS=
# Encrypts the provider keys (OpenAI/Claude/...) saved from the admin
# dashboard. Set a long random string BEFORE saving any key there. If you
# change it later, keys already saved from the dashboard can't be decrypted
# and the server falls back to the environment values. Defaults to JWT_SECRET.
SECRETS_ENCRYPTION_KEY=

# Private FabricNow calibrated body reconstruction worker
BODY_MEASUREMENT_WORKER_URL=https://your-body-worker.example.com
# FABRIC_NOW_INTERNAL_SECRET above must match the worker's secret.

# Manual garment-pattern requests. Mount this path on persistent storage in production.
PATTERN_REQUEST_UPLOAD_DIR=./uploads/pattern-requests
