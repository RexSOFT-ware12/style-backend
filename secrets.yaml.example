# Copy to secrets.yaml (never commit it). Used by app.yaml via `includes`.
# Use a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs every user out once.
env_variables:
  JWT_SECRET: "REPLACE_WITH_LONG_RANDOM_VALUE"
  # PAYSTACK_SECRET_KEY: "sk_live_..."
  # FABRIC_NOW_SERVICE_URL: "https://your-worker-url"
  # FABRIC_NOW_INTERNAL_SECRET: "same value as the worker"
  # RESEND_API_KEY: "re_..."
  # RESEND_FROM_EMAIL: "FabricNow <reply@support.fabricnow.pro>"
  # RESEND_INVOICE_FROM_EMAIL: "FabricNow Invoices <invoices@invoice.fabricnow.pro>"
  # SUPPORT_EMAIL: "support@fabricnow.pro"
  # CONTACT_EMAIL: "support@fabricnow.pro"
